{
  "name": "@kopa-padi/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/db/seed.ts",
    "geo:seed": "tsx src/db/geo-seed.ts",
    "geo:validate": "tsx src/db/geo-validate.ts",
    "geo:check": "npm run geo:validate",
    "geo:scenarios": "tsx src/db/geo-scenarios.ts",
    "geo:import-proximity": "tsx src/db/import-proximity.ts",
    "notifications:retry": "tsx src/jobs/retry-notifications.ts",
    "restrictions:expire": "tsx src/jobs/expire-restrictions.ts",
    "travel-plans:expire": "tsx src/jobs/expire-travel-plans.ts",
    "matching:work": "tsx src/jobs/process-matching.ts",
    "match-offers:expire": "tsx src/jobs/expire-match-offers.ts",
    "circles:lock": "tsx src/jobs/lock-circles.ts",
    "circles:confirm": "tsx src/jobs/request-travel-confirmations.ts",
    "journeys:remind": "tsx src/jobs/process-journey-reminders.ts",
    "guides:review": "tsx src/jobs/review-journey-guides.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^9.2.1",
    "@fastify/rate-limit": "^10.3.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-fastify": "^11.1.6",
    "better-auth": "^1.6.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "5.11.3",
    "file-type": "^21.0.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.0",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
